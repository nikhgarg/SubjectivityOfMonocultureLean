{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Private nonaccepting audit-learning observations",
  "oneOf": [
    {
      "$ref": "#/definitions/cohort"
    },
    {
      "$ref": "#/definitions/event"
    }
  ],
  "definitions": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "texts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/text"
      },
      "uniqueItems": true
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/definitions/text"
        },
        "sha256": {
          "$ref": "#/definitions/sha"
        }
      }
    },
    "refs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ref"
      },
      "uniqueItems": true
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper",
        "source_snapshot_ref",
        "source_result_ids",
        "clause_ids",
        "input_refs",
        "inclusion_probability"
      ],
      "properties": {
        "paper": {
          "$ref": "#/definitions/text"
        },
        "source_snapshot_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/ref"
            }
          ]
        },
        "source_result_ids": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/texts"
            }
          ]
        },
        "clause_ids": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/texts"
            }
          ]
        },
        "input_refs": {
          "allOf": [
            {
              "$ref": "#/definitions/refs"
            }
          ],
          "minItems": 1
        },
        "inclusion_probability": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "source_item_ids": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/text"
          },
          "uniqueItems": true
        }
      }
    },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "artifact_kind",
        "acceptance_credential",
        "cohort_id",
        "registered_at",
        "registration_mode",
        "measurement_role",
        "population_description",
        "selection_rule",
        "sampling_design",
        "sampling_frame_ref",
        "workflow_ref",
        "subjects"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "artifact_kind": {
          "const": "audit_learning_cohort"
        },
        "acceptance_credential": {
          "const": false
        },
        "cohort_id": {
          "$ref": "#/definitions/text"
        },
        "registered_at": {
          "$ref": "#/definitions/text"
        },
        "registration_mode": {
          "enum": [
            "prospective",
            "retrospective_snapshot"
          ]
        },
        "measurement_role": {
          "enum": [
            "development",
            "population_audit"
          ]
        },
        "population_description": {
          "$ref": "#/definitions/text"
        },
        "selection_rule": {
          "$ref": "#/definitions/text"
        },
        "sampling_design": {
          "enum": [
            "targeted",
            "census_selected",
            "probability_sample"
          ]
        },
        "sampling_frame_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/ref"
            }
          ]
        },
        "workflow_ref": {
          "$ref": "#/definitions/ref"
        },
        "subjects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/subject"
          }
        }
      }
    },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "stage",
        "input_refs",
        "configuration_refs",
        "invocation_mode",
        "predecessor_attempt_id",
        "subject_scopes"
      ],
      "properties": {
        "attempt_id": {
          "$ref": "#/definitions/text"
        },
        "stage": {
          "enum": [
            "intake",
            "source_inventory",
            "mapping",
            "semantic_match",
            "proof",
            "result_relationship",
            "presentation",
            "orchestration"
          ]
        },
        "input_refs": {
          "allOf": [
            {
              "$ref": "#/definitions/refs"
            }
          ],
          "minItems": 1
        },
        "configuration_refs": {
          "allOf": [
            {
              "$ref": "#/definitions/refs"
            }
          ],
          "minItems": 1
        },
        "invocation_mode": {
          "enum": [
            "prospective",
            "retrospective"
          ]
        },
        "predecessor_attempt_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "subject_scopes": {
          "$ref": "#/definitions/subjectScopes"
        },
        "invocation_kind": {
          "enum": [
            "judge_call",
            "deterministic_worker",
            "manual_intake",
            "unknown"
          ]
        }
      }
    },
    "finish": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "outcome",
        "reason",
        "raw_output_ref",
        "result_refs",
        "elapsed_seconds",
        "cost_usd",
        "usage_ref"
      ],
      "properties": {
        "attempt_id": {
          "$ref": "#/definitions/text"
        },
        "outcome": {
          "enum": [
            "completed",
            "invalid_output",
            "failed",
            "timed_out",
            "abandoned",
            "uncertain",
            "pending_evidence"
          ]
        },
        "reason": {
          "$ref": "#/definitions/text"
        },
        "raw_output_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/ref"
            }
          ]
        },
        "result_refs": {
          "$ref": "#/definitions/refs"
        },
        "elapsed_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "usage_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/ref"
            }
          ]
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id",
        "first_observed_attempt_id",
        "summary",
        "evidence_refs",
        "subject_scopes"
      ],
      "properties": {
        "issue_id": {
          "$ref": "#/definitions/text"
        },
        "first_observed_attempt_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/text"
            }
          ]
        },
        "summary": {
          "$ref": "#/definitions/text"
        },
        "evidence_refs": {
          "allOf": [
            {
              "$ref": "#/definitions/refs"
            }
          ],
          "minItems": 1
        },
        "subject_scopes": {
          "$ref": "#/definitions/subjectScopes"
        },
        "finding": {
          "$ref": "#/definitions/finding"
        }
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id",
        "disposition",
        "origin",
        "materiality",
        "repair_state",
        "rationale",
        "evidence_refs",
        "source_error_evidence_refs",
        "supersedes_event_id"
      ],
      "properties": {
        "issue_id": {
          "$ref": "#/definitions/text"
        },
        "disposition": {
          "enum": [
            "pending",
            "confirmed",
            "rejected",
            "superseded"
          ]
        },
        "origin": {
          "enum": [
            "source",
            "formalization",
            "judge",
            "presentation",
            "orchestration",
            "undetermined"
          ]
        },
        "materiality": {
          "enum": [
            "material",
            "local",
            "undetermined"
          ]
        },
        "repair_state": {
          "enum": [
            "open",
            "repaired",
            "not_applicable",
            "undetermined"
          ]
        },
        "rationale": {
          "$ref": "#/definitions/text"
        },
        "evidence_refs": {
          "allOf": [
            {
              "$ref": "#/definitions/refs"
            }
          ],
          "minItems": 1
        },
        "source_error_evidence_refs": {
          "$ref": "#/definitions/refs"
        },
        "supersedes_event_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "artifact_kind",
        "acceptance_credential",
        "id",
        "cohort_id",
        "cohort_sha256",
        "recorded_at",
        "event_kind",
        "body"
      ],
      "properties": {
        "schema": {
          "enum": [
            1,
            2,
            3
          ]
        },
        "artifact_kind": {
          "const": "audit_learning_event"
        },
        "acceptance_credential": {
          "const": false
        },
        "id": {
          "type": "string",
          "pattern": "^audit-observation-[0-9a-f]{64}$"
        },
        "cohort_id": {
          "$ref": "#/definitions/text"
        },
        "cohort_sha256": {
          "$ref": "#/definitions/sha"
        },
        "recorded_at": {
          "$ref": "#/definitions/text"
        },
        "event_kind": {
          "enum": [
            "attempt_started",
            "attempt_finished",
            "issue_observed",
            "issue_adjudicated",
            "context_requested",
            "context_supplied",
            "repair_recorded",
            "learning_linked"
          ]
        },
        "body": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "event_kind": {
                "const": "attempt_started"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "#/definitions/start"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_kind": {
                "const": "attempt_finished"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "#/definitions/finish"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_kind": {
                "const": "issue_observed"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "#/definitions/issue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_kind": {
                "const": "issue_adjudicated"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "#/definitions/adjudication"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_kind": {
                "const": "context_requested"
              }
            }
          },
          "then": {
            "properties": {
              "schema": {
                "const": 2
              },
              "body": {
                "$ref": "#/definitions/context_requested"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_kind": {
                "const": "context_supplied"
              }
            }
          },
          "then": {
            "properties": {
              "schema": {
                "const": 2
              },
              "body": {
                "$ref": "#/definitions/context_supplied"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_kind": {
                "const": "repair_recorded"
              }
            }
          },
          "then": {
            "properties": {
              "schema": {
                "const": 2
              },
              "body": {
                "$ref": "#/definitions/repair"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_kind": {
                "const": "learning_linked"
              }
            }
          },
          "then": {
            "properties": {
              "schema": {
                "const": 2
              },
              "body": {
                "$ref": "#/definitions/learning_link"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "schema": {
                "const": 2
              },
              "event_kind": {
                "const": "issue_observed"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "required": [
                  "finding"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "schema": {
                "const": 3
              }
            }
          },
          "then": {
            "properties": {
              "event_kind": {
                "const": "issue_observed"
              },
              "body": {
                "required": [
                  "finding"
                ],
                "properties": {
                  "finding": {
                    "required": [
                      "native_finding_refs"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_kind": {
                "const": "issue_observed"
              },
              "body": {
                "required": [
                  "finding"
                ],
                "properties": {
                  "finding": {
                    "required": [
                      "native_finding_refs"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "schema": {
                "const": 3
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_kind": {
                "const": "issue_observed"
              },
              "body": {
                "required": [
                  "first_observed_attempt_id"
                ],
                "properties": {
                  "first_observed_attempt_id": {
                    "type": "null"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "schema": {
                "const": 3
              },
              "body": {
                "required": [
                  "finding"
                ],
                "properties": {
                  "finding": {
                    "required": [
                      "native_finding_refs"
                    ],
                    "properties": {
                      "capture_mode": {
                        "const": "retrospective_backfill"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "subjectScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper",
        "source_item_ids",
        "clause_ids"
      ],
      "properties": {
        "paper": {
          "$ref": "#/definitions/text"
        },
        "source_item_ids": {
          "$ref": "#/definitions/texts"
        },
        "clause_ids": {
          "$ref": "#/definitions/texts"
        }
      }
    },
    "subjectScopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/subjectScope"
      },
      "uniqueItems": true
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "stage",
        "affected_scopes",
        "clause_scope",
        "lean_targets",
        "evidence",
        "consequence",
        "uncertainty",
        "capture_mode"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/text"
        },
        "kind": {
          "enum": [
            "unavailable_evidence",
            "packet_omission",
            "formalization_mismatch",
            "unproved_obligation",
            "source_error_claim",
            "judge_error_claim",
            "presentation_issue",
            "procedural_issue"
          ]
        },
        "stage": {
          "enum": [
            "intake",
            "source_inventory",
            "mapping",
            "semantic_match",
            "proof",
            "result_relationship",
            "presentation",
            "orchestration"
          ]
        },
        "affected_scopes": {
          "$ref": "#/definitions/subjectScopes"
        },
        "clause_scope": {
          "enum": [
            "whole_items",
            "selected_clauses"
          ]
        },
        "lean_targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "declaration",
              "target_sha256"
            ],
            "properties": {
              "declaration": {
                "$ref": "#/definitions/text"
              },
              "target_sha256": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/definitions/sha"
                  }
                ]
              }
            }
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_ref",
              "selector",
              "kind"
            ],
            "properties": {
              "artifact_ref": {
                "$ref": "#/definitions/ref"
              },
              "selector": {
                "$ref": "#/definitions/text"
              },
              "kind": {
                "enum": [
                  "source",
                  "lean",
                  "review",
                  "reproduction",
                  "report",
                  "transport"
                ]
              }
            }
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "consequence": {
          "enum": [
            "review_blocked",
            "possible_source_error",
            "possible_formalization_mismatch",
            "possible_proof_gap",
            "reporting_only",
            "procedure_only"
          ]
        },
        "uncertainty": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ],
          "properties": {
            "state": {
              "enum": [
                "resolved",
                "missing_evidence",
                "disputed",
                "unknown"
              ]
            },
            "reason": {
              "type": "string"
            }
          }
        },
        "capture_mode": {
          "enum": [
            "contemporaneous",
            "retrospective_backfill"
          ]
        },
        "native_finding_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/native_finding_ref"
          }
        },
        "reported_facts": {
          "$ref": "#/definitions/reported_facts"
        }
      }
    },
    "context_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "finding_id",
        "requested_kind",
        "supplier_owner",
        "selector",
        "reason"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/text"
        },
        "finding_id": {
          "$ref": "#/definitions/text"
        },
        "requested_kind": {
          "enum": [
            "source_passage",
            "lean_declaration",
            "lean_proposition",
            "proof_evidence",
            "retained_graph",
            "supplement_inventory",
            "review_issuance",
            "report_reference",
            "mapping_configuration"
          ]
        },
        "supplier_owner": {
          "$ref": "#/definitions/text"
        },
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "paper",
            "source_item_ids",
            "clause_ids",
            "lean_declarations",
            "artifact_path",
            "expected_sha256"
          ],
          "properties": {
            "paper": {
              "$ref": "#/definitions/text"
            },
            "source_item_ids": {
              "$ref": "#/definitions/texts"
            },
            "clause_ids": {
              "$ref": "#/definitions/texts"
            },
            "lean_declarations": {
              "$ref": "#/definitions/texts"
            },
            "artifact_path": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/definitions/text"
                }
              ]
            },
            "expected_sha256": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/definitions/sha"
                }
              ]
            },
            "expected_original_audit": {
              "$ref": "#/definitions/original_audit_expectation"
            }
          }
        },
        "reason": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "context_requested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id",
        "attempt_id",
        "request"
      ],
      "properties": {
        "issue_id": {
          "$ref": "#/definitions/text"
        },
        "attempt_id": {
          "$ref": "#/definitions/text"
        },
        "request": {
          "$ref": "#/definitions/context_request"
        }
      }
    },
    "context_supplied": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "supplier",
        "supplied_artifact_refs",
        "successor_attempt_id",
        "successor_review_refs",
        "outcome",
        "capture_mode"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/definitions/text"
        },
        "supplier": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "owner",
            "identity_assurance"
          ],
          "properties": {
            "id": {
              "$ref": "#/definitions/text"
            },
            "owner": {
              "$ref": "#/definitions/text"
            },
            "identity_assurance": {
              "enum": [
                "self_declared",
                "externally_attested"
              ]
            }
          }
        },
        "supplied_artifact_refs": {
          "allOf": [
            {
              "$ref": "#/definitions/refs"
            }
          ],
          "minItems": 1
        },
        "successor_attempt_id": {
          "$ref": "#/definitions/text"
        },
        "successor_review_refs": {
          "$ref": "#/definitions/refs"
        },
        "outcome": {
          "enum": [
            "supplied",
            "verified",
            "rejected"
          ]
        },
        "capture_mode": {
          "enum": [
            "contemporaneous",
            "retrospective_backfill"
          ]
