{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Byte-preserving native audit snapshot transport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "artifact_kind", "acceptance_credential", "paper", "origin", "input_refs", "retained_material_refs", "projection_ref", "retention", "review_effect"],
  "properties": {
    "schema": {"const": 1},
    "artifact_kind": {"const": "native_audit_snapshot_transport"},
    "acceptance_credential": {"const": false},
    "paper": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_]*$"},
    "origin": {
      "type": "object", "additionalProperties": false, "required": ["repository", "revision"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "input_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/ref"}},
    "retained_material_refs": {"type": "array", "items": {"$ref": "#/definitions/ref"}},
    "projection_ref": {"$ref": "#/definitions/ref"},
    "retention": {"const": "all_inputs_verified_in_origin_git_tree"},
    "review_effect": {"const": "none_preserve_native_states"}
  },
  "definitions": {
    "ref": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
